{
  // Vite does the building; tsc only checks. The library is imported as
  // source, so its `.ts` imports have to be allowed here too.
  "compilerOptions": {
    // What picks the library's source over its build: see `exports` in its
    // packages' package.json.
    "customConditions": ["@ai-patterns/source"],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", ".storybook", "forge.env.d.ts", "forge.config.ts", "*.mts"]
}
