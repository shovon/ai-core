{
  "name": "@ai-agent-library/providers",
  "version": "0.1.0",
  "description": "Providers for the library, one file each: a vendor's API behind the library's one port. Import the one you use by name; its SDK is yours to install.",
  "private": true,
  "type": "module",
  "exports": {
    "./anthropic": "./anthropic.ts"
  },
  "scripts": {
    "test": "node --test \"*.test.mts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ai-agent-library/library": "*"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
